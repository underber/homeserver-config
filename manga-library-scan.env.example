# Copy to /etc/manga-library-scan.env and restrict it to root (chmod 600).
# Generate admin API/Auth keys in the Kavita and Komga web interfaces.
KAVITA_API_KEY=replace-with-kavita-auth-key
KOMGA_API_KEY=replace-with-komga-api-key

# Defaults point at the loopback-only ports from the Docker Compose files.
KAVITA_URL=http://127.0.0.1:5001
KOMGA_URL=http://127.0.0.1:25600
