[Unit]
Description=Auto sort uploads into music and manga
After=network.target home-volkh-srv-media.mount
BindsTo=home-volkh-srv-media.mount

[Service]
Type=simple
ExecStart=/srv/scripts/media-sort.sh
Restart=always
RestartSec=3
User=volkh
Group=www-data
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/srv/media /srv/downloads /srv/incoming

[Install]
WantedBy=multi-user.target home-volkh-srv-media.mount
